@model EcoLabReaderApp.Models.ElPanelInfo
@{
    Layout = "_Layout";
    int currentIndex = ViewBag.CurrentIndex;
    int totalGoodPanels = ViewBag.TotalGoodPanels;
    bool hasPrevious = ViewBag.HasPrevious;
    bool hasNext = ViewBag.HasNext;
    var existingRecord = ViewBag.ExistingRecord as EcoLabReaderApp.Models.AuditRecord;
}

@section HeaderActions {
    <div class="d-flex align-items-center gap-2">
        <a href="/Audit/Index" class="btn btn-outline-light rounded-3 px-3">
            <i class="fa-solid fa-house me-1"></i>الواجهة الرئيسية (جميع الألواح)
        </a>

        <a href="/Audit/GoodPanels" class="btn btn-success text-white rounded-3 px-3 fw-bold">
            <i class="fa-solid fa-circle-check me-1"></i>الألواح السليمة فقط
        </a>

        <a href="/Audit/DefectivePanels" class="btn btn-outline-danger rounded-3 px-3">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>الألواح المعيبة فقط
        </a>

        @if (hasPrevious)
        {
            <a href="/Audit/GoodPanels?panelIndex=@(currentIndex - 1)" class="btn btn-outline-success rounded-3 px-3">
                <i class="fa-solid fa-arrow-right me-1"></i>اللوح السليم السابق
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary rounded-3 px-3" disabled>
                <i class="fa-solid fa-arrow-right me-1"></i>اللوح السليم السابق
            </button>
        }

        @if (hasNext)
        {
            <a href="/Audit/GoodPanels?panelIndex=@(currentIndex + 1)" class="btn btn-success text-white rounded-3 px-3 fw-bold">
                اللوح السليم التالي<i class="fa-solid fa-arrow-left ms-1"></i>
            </a>
        }

        <span class="badge bg-success fs-6 px-3 py-2 rounded-3">
            لوح سليم @(currentIndex + 1) من @totalGoodPanels
        </span>
    </div>
}

<!-- Top KPI Aggregate Metrics Banner -->
<div class="row g-3 mb-4">
    <div class="col-md-12">
        <div class="card-custom p-3 border-start border-4 border-success d-flex align-items-center justify-content-between">
            <div>
                <small class="text-light d-block mb-1 fw-semibold">عدد الألواح السليمة النموذجية (الخالية تماماً من الأضرار):</small>
                <h3 class="fw-bold text-success m-0">@totalGoodPanels <span class="fs-6 text-light font-normal">لوح سليم (Good_models)</span></h3>
            </div>
            <div class="fs-1 text-success opacity-75">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Main Left Area: Images & info.el Metadata -->
    <div class="col-lg-8">
        <div class="card-custom p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold m-0 text-success"><i class="fa-solid fa-circle-check me-2"></i>معاينة اللوح السليم: <code>@Model.FolderName</code></h5>
                <span class="badge bg-secondary">مجلد: @Model.FolderName</span>
            </div>

            <!-- Two Images Side by Side -->
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="img-container">
                        <span class="position-absolute top-0 start-0 m-2 badge bg-dark opacity-75">row.tif (الصورة الخام)</span>
                        <img src="/Audit/Image?folderName=@Model.FolderName&type=row" alt="Raw Tiff Image" id="imgRaw" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="img-container">
                        <span class="position-absolute top-0 start-0 m-2 badge bg-success opacity-75">marked.tif (المؤشرة)</span>
                        <img src="/Audit/Image?folderName=@Model.FolderName&type=marked" alt="Marked Tiff Image" id="imgMarked" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Info.el Metadata Card -->
        <div class="card-custom p-4">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-circle-info text-primary me-2"></i>المعلومات المقروءة من ملف info.el</h5>
            
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 rounded-3 bg-dark border border-secondary">
                        <small class="text-light d-block mb-1 fw-semibold">الرقم التسلسلي للوح:</small>
                        <strong class="fs-5 text-warning">@Model.SerialNumber</strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-3 bg-dark border border-secondary">
                        <small class="text-light d-block mb-1 fw-semibold">التاريخ والوقت بالضبط:</small>
                        <strong class="fs-6 text-light">@Model.Timestamp</strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-3 bg-dark border border-secondary">
                        <small class="text-light d-block mb-1 fw-semibold">حالة القارئ EL:</small>
                        <span class="badge badge-pass fs-6">✅ PASS (سليم - خالي من العيوب)</span>
                    </div>
                </div>
            </div>

            <div class="mt-3 p-3 rounded-3 bg-dark border border-success">
                <small class="text-success fw-bold d-block mb-1"><i class="fa-solid fa-circle-check me-1"></i>نتائج الفحص:</small>
                <span class="text-success fw-bold"><i class="fa-solid fa-shield-halved me-1"></i>اللوح سليم 100% ولا يحتوي على أية خلايا سيئة أو أضرار.</span>
            </div>
        </div>
    </div>

    <!-- Right Sidebar: Decision Controls -->
    <div class="col-lg-4">
        <div class="card-custom p-4 position-sticky" style="top: 90px;">
            <h5 class="fw-bold mb-4 border-bottom border-secondary pb-3 text-success">
                <i class="fa-solid fa-clipboard-check me-2"></i>قرار التدقيق للوح السليم
            </h5>

            <!-- Current Selection Status -->
            <div id="selectionStatusAlert" class="alert alert-secondary text-center mb-4 rounded-3">
                @if (existingRecord != null)
                {
                    if (existingRecord.IsMatched)
                    {
                        <span class="text-success fw-bold"><i class="fa-solid fa-check-double me-1"></i>تم القرار سابقاً: مطابق</span>
                    }
                    else
                    {
                        <span class="text-danger fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i>تم القرار سابقاً: غير مطابق</span>
                    }
                }
                else
                {
                    <span>يرجى اختيار أحد القرارات أدناه:</span>
                }
            </div>

            <!-- Action Buttons -->
            <div class="d-grid gap-3 mb-4">
                <button type="button" class="btn btn-custom-green btn-lg d-flex align-items-center justify-content-center gap-2" id="btnMatch">
                    <i class="fa-solid fa-circle-check fs-4"></i>
                    <span>معلومات info مطابقة لل marked</span>
                </button>

                <button type="button" class="btn btn-custom-red btn-lg d-flex align-items-center justify-content-center gap-2" id="btnMismatch">
                    <i class="fa-solid fa-circle-xmark fs-4"></i>
                    <span>معلومات info غير مطابقة لل marked</span>
                </button>

                <!-- Re-evaluation Button -->
                <button type="button" class="btn btn-warning text-dark btn-lg fw-bold d-flex align-items-center justify-content-center gap-2 py-3" id="btnReEvaluation" title="قص ونقل هذا اللوح بملفاته إلى مجلد Re_evaluation لمراجعته لاحقاً">
                    <i class="fa-solid fa-folder-arrow-up fs-4"></i>
                    <span>إعادة التقييم (Re_evaluation)</span>
                </button>

                <!-- Move to Useless Button -->
                <button type="button" class="btn btn-dark border border-secondary text-light btn-lg fw-bold d-flex align-items-center justify-content-center gap-2 py-3" id="btnMoveUseless" title="قص ونقل هذا اللوح بملفاته فوراً إلى مجلد Useless للتخلص منه">
                    <i class="fa-solid fa-trash-can text-danger fs-4"></i>
                    <span>ألواح تالفة (Useless)</span>
                </button>
            </div>

            <!-- Toast alert message -->
            <div id="toastAlert" class="alert d-none text-center rounded-3 p-3 mt-3"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const folderName = "@Model.FolderName";
        const panelId = "@Model.PanelId";

        document.getElementById('btnMatch').addEventListener('click', function () {
            saveDecision(true, []);
        });

        document.getElementById('btnMismatch').addEventListener('click', function () {
            saveDecision(false, ["غير مطابق للوحة الـ marked"]);
        });

        document.getElementById('btnReEvaluation').addEventListener('click', function () {
            moveToFolder('/Audit/MoveToReEvaluation', 'Re_evaluation');
        });

        document.getElementById('btnMoveUseless').addEventListener('click', function () {
            moveToFolder('/Audit/MoveToUseless', 'Useless');
        });

        function saveDecision(isMatched, humanCorrections) {
            fetch('/Audit/SaveDecision', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    FolderName: folderName,
                    PanelId: panelId,
                    IsMatched: isMatched,
                    HumanCorrections: humanCorrections
                })
            })
            .then(res => res.json())
            .then(data => {
                const toast = document.getElementById('toastAlert');
                toast.classList.remove('d-none', 'alert-danger', 'alert-success');
                if (data.success) {
                    toast.classList.add('alert-success');
                    toast.innerHTML = '<i class="fa-solid fa-check-circle me-1"></i>' + data.message;
                    setTimeout(() => {
                        window.location.reload();
                    }, 1200);
                } else {
                    toast.classList.add('alert-danger');
                    toast.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i>' + data.message;
                }
            });
        }

        function moveToFolder(endpoint, folderLabel) {
            fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ FolderName: folderName })
            })
            .then(res => res.json())
            .then(data => {
                const toast = document.getElementById('toastAlert');
                toast.classList.remove('d-none', 'alert-danger', 'alert-success');
                if (data.success) {
                    toast.classList.add('alert-success');
                    toast.innerHTML = '<i class="fa-solid fa-check-circle me-1"></i>' + data.message;
                    setTimeout(() => {
                        window.location.href = '/Audit/GoodPanels?panelIndex=@currentIndex';
                    }, 1000);
                } else {
                    toast.classList.add('alert-danger');
                    toast.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i>' + data.message;
                }
            });
        }
    </script>
}
