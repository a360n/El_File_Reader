@model EcoLabReaderApp.Models.ElPanelInfo
@{
    Layout = "_Layout";
    int currentIndex = ViewBag.CurrentIndex;
    int totalGoodPanels = ViewBag.TotalGoodPanels;
    bool hasPrevious = ViewBag.HasPrevious;
    bool hasNext = ViewBag.HasNext;
    var existingRecord = ViewBag.ExistingRecord as EcoLabReaderApp.Models.AuditRecord;
}

@section HeaderActions {
    <div class="d-flex align-items-center gap-2">
        @if (hasPrevious)
        {
            <a href="/Audit/GoodPanels?panelIndex=@(currentIndex - 1)" class="btn btn-outline-success rounded-3 px-3">
                <i class="fa-solid fa-arrow-right me-1"></i>اللوح السليم السابق
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary rounded-3 px-3" disabled>
                <i class="fa-solid fa-arrow-right me-1"></i>اللوح السليم السابق
            </button>
        }

        @if (hasNext)
        {
            <a href="/Audit/GoodPanels?panelIndex=@(currentIndex + 1)" class="btn btn-success text-white rounded-3 px-3 fw-bold">
                اللوح السليم التالي<i class="fa-solid fa-arrow-left ms-1"></i>
            </a>
        }

        <span class="badge bg-success fs-6 px-3 py-2 rounded-3">
            لوح سليم @(currentIndex + 1) من @totalGoodPanels
        </span>
    </div>
}

<!-- Top KPI Aggregate Metrics Banner -->
<div class="row g-3 mb-4">
    <div class="col-md-12">
        <div class="card-custom p-3 border-start border-4 border-success d-flex align-items-center justify-content-between">
            <div>
                <small class="text-light d-block mb-1 fw-semibold">عدد الألواح السليمة النموذجية (الخالية تماماً من الأضرار):</small>
                <h3 class="fw-bold text-success m-0">@totalGoodPanels <span class="fs-6 text-light font-normal">لوح سليم (Good_models)</span></h3>
            </div>
            <div class="fs-1 text-success opacity-75">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Main Left Area: Images & info.el Metadata -->
    <div class="col-lg-8">
        <div class="card-custom p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold m-0 text-success"><i class="fa-solid fa-circle-check me-2"></i>معاينة اللوح السليم: <code>@Model.FolderName</code></h5>
                <span class="badge bg-secondary">مجلد: @Model.FolderName</span>
            </div>

            <!-- Single Full-Width Image Container -->
            <div class="row g-3">
                <div class="col-md-12">
                    <div class="img-container" style="height: 480px;">
                        <span class="position-absolute top-0 start-0 m-2 badge bg-success opacity-75 fs-6"><i class="fa-solid fa-image me-1"></i>رؤية اللوح الشمسي السليم (row.tif)</span>
                        <img src="/Audit/Image?folderName=@Model.FolderName" alt="Solar Panel Image" id="imgRaw" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Info Cards: info.el & info.json side by side -->
        <div class="row g-3">
            <!-- Left Column: info.el Reading -->
            <div class="col-md-6">
                <div class="card-custom p-4 h-100">
                    <h5 class="fw-bold mb-3 text-info"><i class="fa-solid fa-file-invoice text-primary me-2"></i>قراءة ملف info.el</h5>
                    
                    <div class="row g-2">
                        <div class="col-md-12 mb-2">
                            <div class="p-2 rounded-3 bg-dark border border-secondary">
                                <small class="text-light d-block mb-1 fw-semibold">الرقم التسلسلي:</small>
                                <strong class="fs-5 text-warning">@Model.SerialNumber</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-2 rounded-3 bg-dark border border-secondary">
                                <small class="text-light d-block mb-1 fw-semibold">التاريخ والوقت:</small>
                                <small class="text-light">@Model.Timestamp</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-2 rounded-3 bg-dark border border-secondary">
                                <small class="text-light d-block mb-1 fw-semibold">حالة القارئ EL:</small>
                                <span class="badge badge-pass fs-6">✅ PASS</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 p-2 rounded-3 bg-dark border border-success">
                        <small class="text-success fw-bold d-block mb-1"><i class="fa-solid fa-circle-check me-1"></i>نتائج الفحص:</small>
                        <span class="text-success small fw-bold"><i class="fa-solid fa-shield-halved me-1"></i>اللوح سليم 100% ولا يحتوي على أية خلايا سيئة.</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: info.json Reading -->
            <div class="col-md-6">
                <div class="card-custom p-4 h-100 border border-success">
                    <h5 class="fw-bold mb-3 text-success"><i class="fa-solid fa-file-code me-2"></i>قراءة ملف info.json</h5>
                    @if (Model.HasJsonFile && Model.JsonData != null)
                    {
                        <div class="row g-2">
                            <div class="col-md-12 mb-2">
                                <div class="p-2 rounded-3 bg-dark border border-secondary">
                                    <small class="text-light d-block mb-1 fw-semibold">الرقم التسلسلي (JSON):</small>
                                    <strong class="fs-5 text-warning">@Model.JsonData.SerialNumber</strong>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2 rounded-3 bg-dark border border-secondary">
                                    <small class="text-light d-block mb-1 fw-semibold">التاريخ (JSON):</small>
                                    <small class="text-light">@Model.JsonData.Timestamp</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2 rounded-3 bg-dark border border-secondary">
                                    <small class="text-light d-block mb-1 fw-semibold">حالة الـ JSON:</small>
                                    <span class="badge bg-success">@Model.JsonData.Status</span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3 p-2 rounded-3 bg-dark border border-success">
                            <small class="text-success fw-bold d-block mb-1"><i class="fa-solid fa-check-circle me-1"></i>نتائج الـ JSON:</small>
                            <span class="text-success small fw-bold">اللوح سليم 100% ومطابق لبيانات الـ JSON.</span>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-dark text-muted text-center p-4 m-0 rounded-3 border border-secondary h-100 d-flex flex-column align-items-center justify-content-center">
                            <i class="fa-solid fa-file-circle-xmark fs-2 mb-2 d-block text-secondary"></i>
                            <small class="d-block fw-bold mb-1">لا يوجد ملف info.json لـ هذا اللوح بعد.</small>
                            <small class="text-muted">اضغط على زر "فحص وتوليد ملفات JSON" في القائمة الجانبية لتوليده.</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Sidebar: 3 Decision Controls & Keyboard Shortcuts -->
    <div class="col-lg-4">
        <div class="card-custom p-4 position-sticky" style="top: 90px;">
            <h5 class="fw-bold mb-4 border-bottom border-secondary pb-3 text-success">
                <i class="fa-solid fa-clipboard-check me-2"></i>قرار الإقرار والتدقيق للوح السليم
            </h5>

            <!-- 3 Clean Decision Action Buttons -->
            <div class="d-grid gap-3 mb-4">
                <!-- Action 1: No Problem / Keep Panel (Shortcut A) -->
                @if (hasNext)
                {
                    <a href="/Audit/GoodPanels?panelIndex=@(currentIndex + 1)" id="btnKeep" class="btn btn-success btn-lg fw-bold d-flex align-items-center justify-content-center gap-2 py-3 shadow">
                        <i class="fa-solid fa-circle-check fs-4"></i>
                        <span>لا توجد مشكلة (إبقاء - A)</span>
                    </a>
                }
                else
                {
                    <a href="/Audit/GoodPanels" id="btnKeep" class="btn btn-success btn-lg fw-bold d-flex align-items-center justify-content-center gap-2 py-3 shadow">
                        <i class="fa-solid fa-circle-check fs-4"></i>
                        <span>لا توجد مشكلة (إبقاء - A)</span>
                    </a>
                }

                <!-- Action 2: Re-evaluation (Shortcut R) -->
                <button type="button" class="btn btn-warning text-dark btn-lg fw-bold d-flex align-items-center justify-content-center gap-2 py-3 shadow" id="btnReEvaluation" title="قص ونقل هذا اللوح بملفاته إلى مجلد Re_evaluation لمراجعته لاحقاً">
                    <i class="fa-solid fa-folder-arrow-up fs-4"></i>
                    <span>إعادة التقييم (Re_evaluation - R)</span>
                </button>

                <!-- Action 3: Damaged / Useless (Shortcut U) -->
                <button type="button" class="btn btn-dark border border-secondary text-light btn-lg fw-bold d-flex align-items-center justify-content-center gap-2 py-3 shadow" id="btnMoveUseless" title="قص ونقل هذا اللوح بملفاته فوراً إلى مجلد Useless للتخلص منه">
                    <i class="fa-solid fa-trash-can text-danger fs-4"></i>
                    <span>ألواح تالفة (Useless - U)</span>
                </button>
            </div>

            <!-- Keyboard Shortcuts Legend Box -->
            <div class="p-3 rounded-3 bg-dark border border-secondary text-center mb-2">
                <small class="text-light fw-bold d-block mb-2"><i class="fa-solid fa-keyboard me-1 text-info"></i>اختصارات لوحة المفاتيح المباشرة:</small>
                <div class="d-flex justify-content-around">
                    <span class="badge bg-success fs-6"><kbd>A</kbd> إبقاء وتالي</span>
                    <span class="badge bg-warning text-dark fs-6"><kbd>R</kbd> إعادة التقييم</span>
                    <span class="badge bg-danger fs-6"><kbd>U</kbd> تالف Useless</span>
                </div>
            </div>

            <div id="toastAlert" class="alert d-none text-center rounded-3 p-3 mt-3"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const folderName = "@Model.FolderName";
        const currentIndex = @currentIndex;

        const btnReEvaluation = document.getElementById('btnReEvaluation');
        const btnMoveUseless = document.getElementById('btnMoveUseless');

        // Re-evaluation Handler (Shortcut R)
        btnReEvaluation.addEventListener('click', async () => {
            btnReEvaluation.disabled = true;
            btnReEvaluation.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>جاري النقل...';

            try {
                const response = await fetch('/Audit/MoveToReEvaluation', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ folderName: folderName })
                });

                const res = await response.json();
                if (res.success) {
                    window.location.href = `/Audit/GoodPanels?panelIndex=${currentIndex}`;
                } else {
                    alert('خطأ أثناء النقل: ' + res.message);
                    btnReEvaluation.disabled = false;
                    btnReEvaluation.innerHTML = '<i class="fa-solid fa-folder-arrow-up fs-4"></i><span>إعادة التقييم (Re_evaluation - R)</span>';
                }
            } catch (err) {
                alert('خطأ بالاتصال بالسيرفر: ' + err.message);
                btnReEvaluation.disabled = false;
                btnReEvaluation.innerHTML = '<i class="fa-solid fa-folder-arrow-up fs-4"></i><span>إعادة التقييم (Re_evaluation - R)</span>';
            }
        });

        // Useless Handler (Shortcut U)
        btnMoveUseless.addEventListener('click', async () => {
            btnMoveUseless.disabled = true;
            btnMoveUseless.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>جاري النقل...';

            try {
                const response = await fetch('/Audit/MoveToUseless', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ folderName: folderName })
                });

                const res = await response.json();
                if (res.success) {
                    window.location.href = `/Audit/GoodPanels?panelIndex=${currentIndex}`;
                } else {
                    alert('خطأ أثناء النقل: ' + res.message);
                    btnMoveUseless.disabled = false;
                    btnMoveUseless.innerHTML = '<i class="fa-solid fa-trash-can text-danger fs-4"></i><span>ألواح تالفة (Useless - U)</span>';
                }
            } catch (err) {
                alert('خطأ بالاتصال بالسيرفر: ' + err.message);
                btnMoveUseless.disabled = false;
                btnMoveUseless.innerHTML = '<i class="fa-solid fa-trash-can text-danger fs-4"></i><span>ألواح تالفة (Useless - U)</span>';
            }
        });

        // Fast Keyboard Shortcuts (R = Re_evaluation, U = Useless, A = Keep / Next Panel)
        document.addEventListener('keydown', function (e) {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;

            const key = e.key.toLowerCase();
            if (key === 'r') {
                e.preventDefault();
                btnReEvaluation?.click();
            } else if (key === 'u') {
                e.preventDefault();
                btnMoveUseless?.click();
            } else if (key === 'a') {
                e.preventDefault();
                const keepBtn = document.getElementById('btnKeep');
                if (keepBtn) {
                    window.location.href = keepBtn.getAttribute('href');
                }
            }
        });
    </script>
}
