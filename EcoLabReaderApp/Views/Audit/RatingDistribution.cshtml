@model List<(string Folder, EcoLabReaderApp.Models.ElPanelInfo Info, int OriginalIndex)>
@{
    Layout = "_Layout";
    string activeGrade = ViewBag.ActiveGrade;
    int totalPanels = ViewBag.TotalPanels;
    int gradeACount = ViewBag.GradeACount;
    int gradeBCount = ViewBag.GradeBCount;
    int gradeCCount = ViewBag.GradeCCount;
    int gradeDCount = ViewBag.GradeDCount;
}

@section HeaderActions {
    <div class="d-flex align-items-center gap-2">
        <a href="/Audit/Index" class="btn btn-outline-light rounded-3 px-3">
            <i class="fa-solid fa-house me-1"></i>الواجهة الرئيسية
        </a>

        <a href="/Audit/DefectivePanels" class="btn btn-outline-danger rounded-3 px-3">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>الألواح المعيبة فقط
        </a>

        <a href="/Audit/RatingDistribution" class="btn btn-info text-dark rounded-3 px-3 fw-bold">
            <i class="fa-solid fa-star-half-stroke me-1"></i>توزيع الألواح حسب التقييم
        </a>

        <a href="/Audit/Log" class="btn btn-custom-blue rounded-3 px-3">
            <i class="fa-solid fa-chart-pie me-1"></i>سجل المطابقة
        </a>
    </div>
}

<!-- Top KPI Summary Cards Banner -->
<div class="row g-3 mb-4">
    <div class="col">
        <div class="card-custom p-3 border-start border-4 border-light d-flex align-items-center justify-content-between">
            <div>
                <small class="text-muted d-block mb-1">إجمالي الألواح:</small>
                <h4 class="fw-bold text-light m-0">@totalPanels <span class="fs-6 text-muted">لوح</span></h4>
            </div>
            <div class="fs-2 text-light opacity-50"><i class="fa-solid fa-solar-panel"></i></div>
        </div>
    </div>
    <div class="col">
        <div class="card-custom p-3 border-start border-4 border-success d-flex align-items-center justify-content-between">
            <div>
                <small class="text-muted d-block mb-1">درجة A (كاملة ⭐⭐⭐):</small>
                <h4 class="fw-bold text-success m-0">@gradeACount <span class="fs-6 text-muted">لوح</span></h4>
            </div>
            <div class="fs-2 text-success opacity-50"><i class="fa-solid fa-star"></i></div>
        </div>
    </div>
    <div class="col">
        <div class="card-custom p-3 border-start border-4 border-info d-flex align-items-center justify-content-between">
            <div>
                <small class="text-muted d-block mb-1">درجة B (ثلثين ⭐⭐☆):</small>
                <h4 class="fw-bold text-info m-0">@gradeBCount <span class="fs-6 text-muted">لوح</span></h4>
            </div>
            <div class="fs-2 text-info opacity-50"><i class="fa-solid fa-star-half-stroke"></i></div>
        </div>
    </div>
    <div class="col">
        <div class="card-custom p-3 border-start border-4 border-warning d-flex align-items-center justify-content-between">
            <div>
                <small class="text-muted d-block mb-1">درجة C (ثلث ⭐☆☆):</small>
                <h4 class="fw-bold text-warning m-0">@gradeCCount <span class="fs-6 text-muted">لوح</span></h4>
            </div>
            <div class="fs-2 text-warning opacity-50"><i class="fa-regular fa-star"></i></div>
        </div>
    </div>
    <div class="col">
        <div class="card-custom p-3 border-start border-4 border-danger d-flex align-items-center justify-content-between">
            <div>
                <small class="text-muted d-block mb-1">درجة D (صفر ☆☆☆):</small>
                <h4 class="fw-bold text-danger m-0">@gradeDCount <span class="fs-6 text-muted">لوح</span></h4>
            </div>
            <div class="fs-2 text-danger opacity-50"><i class="fa-solid fa-ban"></i></div>
        </div>
    </div>
</div>

<!-- Interactive Rating Filter Navigation Bar -->
<div class="card-custom p-3 mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold text-light me-2"><i class="fa-solid fa-filter text-info me-1"></i>فلترة الألواح حسب التقييم:</span>
            
            <a href="/Audit/RatingDistribution?grade=ALL" class="btn @(activeGrade == "ALL" ? "btn-primary active fw-bold" : "btn-outline-secondary text-light") rounded-3 px-3">
                عرض الكل (@totalPanels)
            </a>

            <a href="/Audit/RatingDistribution?grade=A" class="btn @(activeGrade == "A" ? "btn-success active fw-bold" : "btn-outline-success") rounded-3 px-3">
                ⭐⭐⭐ درجة A (@gradeACount)
            </a>

            <a href="/Audit/RatingDistribution?grade=B" class="btn @(activeGrade == "B" ? "btn-info active text-dark fw-bold" : "btn-outline-info") rounded-3 px-3">
                ⭐⭐☆ درجة B (@gradeBCount)
            </a>

            <a href="/Audit/RatingDistribution?grade=C" class="btn @(activeGrade == "C" ? "btn-warning active text-dark fw-bold" : "btn-outline-warning") rounded-3 px-3">
                ⭐☆☆ درجة C (@gradeCCount)
            </a>

            <a href="/Audit/RatingDistribution?grade=D" class="btn @(activeGrade == "D" ? "btn-danger active fw-bold" : "btn-outline-danger") rounded-3 px-3">
                ☆☆☆ درجة D (@gradeDCount)
            </a>
        </div>

        <span class="badge bg-dark border border-secondary text-muted px-3 py-2">
            عدد الألواح المعروضة حالياً: @Model.Count
        </span>
    </div>
</div>

<!-- Chronological Panel Cards List -->
@if (Model.Count == 0)
{
    <div class="card-custom p-5 text-center my-4">
        <i class="fa-solid fa-folder-open text-muted fs-1 mb-3"></i>
        <h5 class="text-muted fw-bold">لا توجد ألواح مطابقة للتقييم المحدد (@activeGrade).</h5>
        <a href="/Audit/RatingDistribution?grade=ALL" class="btn btn-outline-info rounded-3 mt-3">عرض جميع الألواح</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var panel in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card-custom h-100 p-3 d-flex flex-column justify-content-between border border-secondary hover-shadow">
                    <div>
                        <!-- Card Header: Folder Name & Serial -->
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary">
                            <strong class="text-warning font-monospace fs-6">@panel.Info.SerialNumber</strong>
                            <small class="text-muted"><i class="fa-regular fa-clock me-1"></i>@panel.Info.Timestamp</small>
                        </div>

                        <!-- Panel Image Previews -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="img-container" style="height: 140px;">
                                    <span class="position-absolute top-0 start-0 m-1 badge bg-dark opacity-75 small" style="font-size: 10px;">row.tif</span>
                                    <img src="/Audit/Image?folderName=@panel.Info.FolderName&type=row" alt="Row Tiff" style="max-height: 140px; object-fit: contain;" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="img-container" style="height: 140px;">
                                    <span class="position-absolute top-0 start-0 m-1 badge bg-dark opacity-75 small" style="font-size: 10px;">marked.tif</span>
                                    <img src="/Audit/Image?folderName=@panel.Info.FolderName&type=marked" alt="Marked Tiff" style="max-height: 140px; object-fit: contain;" />
                                </div>
                            </div>
                        </div>

                        <!-- Rating Badge & Status -->
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div>
                                <small class="text-muted d-block small">التقييم:</small>
                                @if (panel.Info.Rating.Contains("درجة A") || panel.Info.Rating.Contains("1 Star") || panel.Info.Rating.Contains("كاملة"))
                                {
                                    <span class="badge bg-success fs-6">⭐⭐⭐ درجة A</span>
                                }
                                else if (panel.Info.Rating.Contains("درجة B") || panel.Info.Rating.Contains("2/3 Stars") || panel.Info.Rating.Contains("ثلثين"))
                                {
                                    <span class="badge bg-info text-dark fs-6">⭐⭐☆ درجة B</span>
                                }
                                else if (panel.Info.Rating.Contains("درجة C") || panel.Info.Rating.Contains("1/3 Star") || panel.Info.Rating.Contains("ثلث"))
                                {
                                    <span class="badge bg-warning text-dark fs-6">⭐☆☆ درجة C</span>
                                }
                                else if (panel.Info.Rating.Contains("درجة D") || panel.Info.Rating.Contains("0 Stars") || panel.Info.Rating.Contains("صفر"))
                                {
                                    <span class="badge bg-danger fs-6">☆☆☆ درجة D</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white fs-6">@panel.Info.Rating</span>
                                }
                            </div>

                            <div>
                                <small class="text-muted d-block small">الحالة:</small>
                                @if (panel.Info.IsDefective)
                                {
                                    <span class="badge bg-danger text-white">❌ FAIL (معيب)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success text-white">✅ PASS (سليم)</span>
                                }
                            </div>
                        </div>

                        <!-- Defects list preview if any -->
                        <div class="mt-2 mb-3">
                            <small class="text-muted d-block small">الخلايا المتضررة (@panel.Info.Defects.Count):</small>
                            @if (panel.Info.Defects.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var def in panel.Info.Defects.Take(4))
                                    {
                                        <span class="badge bg-danger border border-warning" style="font-size: 11px;">@def</span>
                                    }
                                    @if (panel.Info.Defects.Count > 4)
                                    {
                                        <span class="badge bg-secondary" style="font-size: 11px;">+@(panel.Info.Defects.Count - 4) إضافية</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">لا توجد عيوب خلوية مرسومة</span>
                            }
                        </div>
                    </div>

                    <!-- Direct Navigation Action Button -->
                    <div class="pt-2 border-top border-secondary">
                        <a href="/Audit/Index?panelIndex=@panel.OriginalIndex" class="btn btn-outline-info w-100 rounded-3 d-flex align-items-center justify-content-center gap-2">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <span>فتح وتدقيق اللوح في الواجهة الرئيسية</span>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
