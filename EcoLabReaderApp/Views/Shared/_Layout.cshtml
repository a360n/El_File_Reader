<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EcoLAB EL File Reader & AI Dataset Auditor</title>
    
    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <!-- Google Cairo Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --accent-blue: #38bdf8;
            --accent-green: #22c55e;
            --accent-red: #ef4444;
            --accent-yellow: #f59e0b;
            --accent-orange: #f97316;
            --text-main: #f8fafc;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
        }

        .navbar-custom {
            background-color: rgba(30, 41, 59, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .card-custom {
            background-color: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .btn-custom-green {
            background-color: var(--accent-green);
            color: #fff;
            border: none;
            font-weight: 700;
        }

        .btn-custom-green:hover {
            background-color: #16a34a;
            color: #fff;
        }

        .btn-custom-red {
            background-color: var(--accent-red);
            color: #fff;
            border: none;
            font-weight: 700;
        }

        .btn-custom-red:hover {
            background-color: #dc2626;
            color: #fff;
        }

        .btn-custom-blue {
            background-color: #0284c7;
            color: #fff;
            border: none;
            font-weight: 700;
        }

        .btn-custom-blue:hover {
            background-color: #0369a1;
            color: #fff;
        }

        .img-container {
            position: relative;
            width: 100%;
            height: 380px;
            background-color: #020617;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .img-container img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: transform 0.3s ease;
        }

        .img-container img:hover {
            transform: scale(1.15);
            cursor: zoom-in;
        }

        .badge-pass {
            background-color: rgba(34, 197, 94, 0.2);
            color: #4ade80;
            border: 1px solid #22c55e;
        }

        .badge-fail {
            background-color: rgba(239, 68, 68, 0.2);
            color: #f87171;
            border: 1px solid #ef4444;
        }

        .table-custom {
            color: var(--text-main);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .table-custom th {
            background-color: #0f172a;
            color: var(--accent-blue);
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
        }

        .table-custom td {
            background-color: var(--card-bg);
        }

        .offcanvas-custom {
            background-color: var(--card-bg);
            color: var(--text-main);
            border-left: 1px solid rgba(255, 255, 255, 0.1);
            width: 320px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 18px;
            border-radius: 12px;
            color: var(--text-main);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.2s ease;
            border: 1px solid transparent;
        }

        .sidebar-link:hover {
            background-color: rgba(255, 255, 255, 0.08);
            color: #38bdf8;
            border-color: rgba(56, 189, 248, 0.2);
        }

        .sidebar-link.active {
            background-color: rgba(56, 189, 248, 0.15);
            color: #38bdf8;
            border-color: #38bdf8;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Offcanvas Sliding Sidebar Drawer -->
    <div class="offcanvas offcanvas-start offcanvas-custom" tabindex="-1" id="sidebarDrawer" aria-labelledby="sidebarDrawerLabel">
        <div class="offcanvas-header border-bottom border-secondary pb-3">
            <h5 class="offcanvas-title fw-bold text-info" id="sidebarDrawerLabel">
                <i class="fa-solid fa-bars-staggered me-2"></i>القائمة الرئيسية
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column justify-content-between p-4">
            <div class="d-grid gap-2">
                <a href="/Audit/Index" class="sidebar-link">
                    <i class="fa-solid fa-house fs-5 text-primary"></i>
                    <span>الواجهة الرئيسية (جميع الألواح)</span>
                </a>
                <a href="/Audit/GoodPanels" class="sidebar-link">
                    <i class="fa-solid fa-circle-check fs-5 text-success"></i>
                    <span>الألواح السليمة (Good_models)</span>
                </a>
                <a href="/Audit/DefectivePanels" class="sidebar-link">
                    <i class="fa-solid fa-triangle-exclamation fs-5 text-danger"></i>
                    <span>الألواح المعيبة (bad_models)</span>
                </a>
                <a href="/Audit/ReEvaluationPanels" class="sidebar-link">
                    <i class="fa-solid fa-folder-arrow-up fs-5 text-warning"></i>
                    <span>إعادة التقييم (Re_evaluation)</span>
                </a>
                <a href="/Audit/UselessPanels" class="sidebar-link">
                    <i class="fa-solid fa-trash-can fs-5 text-secondary"></i>
                    <span>الألواح التالفة (Useless)</span>
                </a>

                <hr class="border-secondary my-2" />

                <a href="/Audit/Search" class="sidebar-link bg-dark border border-info text-info">
                    <i class="fa-solid fa-magnifying-glass fs-5"></i>
                    <span>البحث عن لوح بالرقم التسلسلي</span>
                </a>

                <button type="button" class="sidebar-link w-100 text-start bg-dark border border-warning text-warning" id="btnDrawerRestructure">
                    <i class="fa-solid fa-rotate fs-5"></i>
                    <span>إعادة فرز الـ container</span>
                </button>
            </div>

            <div class="p-3 rounded-3 bg-dark border border-secondary text-center mt-4">
                <small class="text-light fw-bold d-block mb-2"><i class="fa-solid fa-keyboard me-1 text-info"></i>اختصارات لوحة المفاتيح:</small>
                <div class="d-flex justify-content-around">
                    <span class="badge bg-success fs-6"><kbd>A</kbd> إبقاء</span>
                    <span class="badge bg-warning text-dark fs-6"><kbd>R</kbd> إعادة تقييم</span>
                    <span class="badge bg-danger fs-6"><kbd>U</kbd> تالف</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top py-3">
        <div class="container-fluid px-4">
            <div class="d-flex align-items-center gap-3">
                <!-- Hamburger Menu Button in top right corner -->
                <button class="btn btn-outline-light rounded-3 px-3 py-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarDrawer" aria-controls="sidebarDrawer" title="القائمة الجانبية">
                    <i class="fa-solid fa-bars fs-4"></i>
                </button>

                <a class="navbar-brand d-flex align-items-center gap-3 text-white fw-bold m-0" href="/Audit/Index">
                    <i class="fa-solid fa-microchip text-info fs-3"></i>
                    <span>قارئ EcoLAB EL وتدقيق بيانات الذكاء الاصطناعي</span>
                </a>
            </div>

            <div class="d-flex align-items-center gap-3">
                @RenderSection("HeaderActions", required: false)
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4 py-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global Restructure listener for the Sidebar Drawer button
        const btnDrawerRestructure = document.getElementById('btnDrawerRestructure');
        if (btnDrawerRestructure) {
            btnDrawerRestructure.addEventListener('click', async () => {
                btnDrawerRestructure.disabled = true;
                btnDrawerRestructure.innerHTML = '<i class="fa-solid fa-spinner fa-spin fs-5"></i><span>جاري الفرز...</span>';
                try {
                    const res = await fetch('/Audit/TriggerRestructure', { method: 'POST' });
                    const data = await res.json();
                    alert(data.message);
                    window.location.reload();
                } catch (e) {
                    alert('حدث خطأ أثناء الفرز: ' + e.message);
                    btnDrawerRestructure.disabled = false;
                    btnDrawerRestructure.innerHTML = '<i class="fa-solid fa-rotate fs-5"></i><span>إعادة فرز الـ container</span>';
                }
            });
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
